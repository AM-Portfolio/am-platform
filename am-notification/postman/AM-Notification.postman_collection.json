{
  "info": {
    "_postman_id": "am-notification-collection-v1",
    "name": "AM Notification Service",
    "description": "Organized API collection for **am-notification** (port 8111).\n\n## Quick start\n1. Prefer the unified **AM Platform** collection; this file is builder source.\n2. Set `notification_client_secret` from `.secrets.env`\n3. Run **Health → Ready Check**\n4. Run **Keycloak Helpers → Client Credentials (am-notification-service)**\n5. Run **Internal → Send Notification**\n6. Inbox routes need an Identity login first\n\n## Folders\n| Folder | Purpose |\n|--------|----------|\n| Health | Liveness + readiness |\n| Inbox | User JWT — list, unread, mark read |\n| Preferences | User notification preferences |\n| Internal | Service token — synchronous send |\n| Keycloak Helpers | Machine tokens |",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8111"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "service_access_token",
      "value": ""
    },
    {
      "key": "user_sub",
      "value": "test-user-1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/live"
          }
        },
        {
          "name": "Ready Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/ready"
          }
        }
      ],
      "description": "Liveness and readiness."
    },
    {
      "name": "Inbox",
      "item": [
        {
          "name": "List My Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/notifications/me?page=0&page_size=20"
          }
        },
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/notifications/me/unread-count"
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/notifications/read-all"
          }
        }
      ],
      "description": "Bearer required."
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get Preferences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/notifications/preferences"
          }
        },
        {
          "name": "Update Preferences",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channels\": {\"email\": true, \"in_app\": true},\n  \"categories\": {\"security\": true, \"subscription\": true}\n}"
            },
            "url": "{{base_url}}/notifications/preferences"
          }
        }
      ],
      "description": "Bearer required."
    },
    {
      "name": "Internal",
      "item": [
        {
          "name": "Send Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{service_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflow_key\": \"identity.login_new_device\",\n  \"recipient_user_id\": \"{{user_sub}}\",\n  \"payload\": {\n    \"device\": \"Chrome on Windows\",\n    \"ip_address\": \"203.0.113.10\"\n  },\n  \"critical\": true,\n  \"category\": \"security\"\n}"
            },
            "url": "{{base_url}}/notifications/internal/send"
          }
        }
      ],
      "description": "Service-account token required."
    },
    {
      "name": "Keycloak Helpers",
      "item": [
        {
          "name": "Client Credentials (am-notification-service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  if (b.access_token) pm.environment.set('service_access_token', b.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{notification_client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{notification_client_secret}}"
                }
              ]
            },
            "url": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token"
          }
        }
      ],
      "description": "Direct token calls for setup and debug."
    }
  ]
}
