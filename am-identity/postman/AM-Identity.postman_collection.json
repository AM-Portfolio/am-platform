  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Service liveness. Expect `{\"status\":\"ok\",\"service\":\"am-identity\"}`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 Auth — Registration",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\"\n}"
            },
            "url": "{{base_url}}/auth/register",
            "description": "Creates a user in Keycloak (admin API). Use a unique email per run."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Auth — Login & Session",
      "item": [
        {
          "name": "Login (Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"platform\": \"android\"\n}"
            },
            "url": "{{base_url}}/auth/login",
            "description": "Password grant via am-identity-service client. Saves `access_token` and `refresh_token`."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\",\n  \"client_id\": \"am-android-client\"\n}"
            },
            "url": "{{base_url}}/auth/refresh",
            "description": "Exchange refresh token for new access token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout",
            "description": "Revokes refresh token session. Returns 204."
          },
          "response": []
        },
        {
          "name": "Login OTP (Not Implemented)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_email}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{base_url}}/auth/login/otp",
            "description": "Scaffolded — currently returns 501 until OTP flow is implemented."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Auth — Google SSO",
      "description": "**Browser broker flow:**\n1. **Get Google Auth URL** → open `auth_url` in browser\n2. After redirect, copy `code` + `state` → **Google Callback**\n\n**Flutter / mobile id_token flow:**\n1. Obtain a Google `id_token` (see `automation/scripts/google-id-token.html`)\n2. Set env `google_id_token`\n3. Run **Google Token Login**",
      "item": [
        {
          "name": "Get Google Auth URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  if (b.auth_url) console.log('Open in browser:\\n' + b.auth_url);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"redirect_uri\": \"{{google_redirect_uri}}\"\n}"
            },
            "url": "{{base_url}}/auth/google/url",
            "description": "Returns Keycloak auth URL with `kc_idp_hint=google` and anti-replay `state`."
          },
          "response": []
        },
        {
          "name": "Google Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{google_auth_code}}\",\n  \"state\": \"{{google_state}}\",\n  \"redirect_uri\": \"{{google_redirect_uri}}\"\n}"
            },
            "url": "{{base_url}}/auth/google/callback",
            "description": "Exchange authorization code for AM tokens. `redirect_uri` must match the one used in step 1."
          },
          "response": []
        },
        {
          "name": "Google Token Login (id_token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/google/token",
            "description": "Same endpoint as Flutter GSI: exchange Google id_token for Keycloak/AM tokens. Requires `google_id_token` env var (1h TTL)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 Users (Bearer Required)",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/me",
            "description": "Returns profile from Keycloak userinfo + JWT roles."
          },
          "response": []
        },
        {
          "name": "Update My Settings",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": {\n    \"theme\": \"dark\",\n    \"notifications\": true,\n    \"language\": \"en\"\n  }\n}"
            },
            "url": "{{base_url}}/users/me/settings",
            "description": "Patches user attributes in Keycloak (settings stored as user attribute)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 Internal (Service Token Required)",
      "description": "Requires a **service account** JWT (role: `service`).\nRun **99 Keycloak Helpers → Client Credentials (am-identity-service)** first and use that token as `access_token`, or set `service_access_token` in environment.",
      "item": [
        {
          "name": "Issue Service Token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audience\": null\n}"
            },
            "url": "{{base_url}}/internal/auth/service-token",
            "description": "Issues a machine token for downstream service calls."
          },
          "response": []
        },
        {
          "name": "Get Internal User By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/internal/users/{{user_sub}}",
            "description": "Internal lookup stub. Set `user_sub` from login/profile response."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 Auth — Device Link",
      "description": "QR web login backend. Run **Start** first (PKCE auto-generated).",
      "item": [
        {
          "name": "Device Link Start",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const verifier = pm.variables.replaceIn('{{$guid}}') + pm.variables.replaceIn('{{$guid}}');",
                  "const hash = CryptoJS.SHA256(verifier).toString(CryptoJS.enc.Base64)",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "pm.environment.set('code_verifier', verifier);",
                  "pm.collectionVariables.set('code_verifier', verifier);",
                  "pm.environment.set('code_challenge', hash);",
                  "pm.collectionVariables.set('code_challenge', hash);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  try {",
                  "    const body = pm.response.json();",
                  "    if (body.device_link_id) {",
                  "      pm.environment.set('device_link_id', body.device_link_id);",
                  "      pm.collectionVariables.set('device_link_id', body.device_link_id);",
                  "    }",
                  "    if (body.confirmation_code) {",
                  "      pm.environment.set('confirmation_code', body.confirmation_code);",
                  "      pm.collectionVariables.set('confirmation_code', body.confirmation_code);",
                  "    }",
                  "    if (body.otp_session_id) {",
                  "      pm.environment.set('otp_session_id', body.otp_session_id);",
                  "    }",
                  "    if (body.step_up_token) {",
                  "      pm.environment.set('step_up_token', body.step_up_token);",
                  "    }",
                  "    const cookie = pm.cookies.get('am_session');",
                  "    if (cookie) pm.environment.set('am_session', cookie);",
                  "    if (Array.isArray(body) && body.length) {",
                  "      if (body[0].session_id) pm.environment.set('login_session_id', body[0].session_id);",
                  "      if (body[0].event_id) pm.environment.set('security_event_id', body[0].event_id);",
                  "    }",
                  "  } catch (e) {}",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "User-Agent",
                "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client\": \"web\",\n  \"redirect_hint\": \"http://localhost:9000/login\",\n  \"code_challenge\": \"{{code_challenge}}\",\n  \"browser\": \"Chrome\",\n  \"os\": \"Windows\"\n}"
            },
            "url": "{{base_url}}/auth/device-link/start",
            "description": "Creates device link; saves device_link_id and confirmation_code."
          },
          "response": []
        },
        {
          "name": "Device Link Status (Poll)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  try {",
                  "    const body = pm.response.json();",
                  "    if (body.device_link_id) {",
                  "      pm.environment.set('device_link_id', body.device_link_id);",
                  "      pm.collectionVariables.set('device_link_id', body.device_link_id);",
                  "    }",
                  "    if (body.confirmation_code) {",
                  "      pm.environment.set('confirmation_code', body.confirmation_code);",
                  "      pm.collectionVariables.set('confirmation_code', body.confirmation_code);",
                  "    }",
                  "    if (body.otp_session_id) {",
                  "      pm.environment.set('otp_session_id', body.otp_session_id);",
                  "    }",
                  "    if (body.step_up_token) {",
                  "      pm.environment.set('step_up_token', body.step_up_token);",
                  "    }",
                  "    const cookie = pm.cookies.get('am_session');",
                  "    if (cookie) pm.environment.set('am_session', cookie);",
                  "    if (Array.isArray(body) && body.length) {",
                  "      if (body[0].session_id) pm.environment.set('login_session_id', body[0].session_id);",
                  "      if (body[0].event_id) pm.environment.set('security_event_id', body[0].event_id);",
                  "    }",
                  "  } catch (e) {}",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Machine-Trust-Key",
                "value": "{{machine_trust_key}}"
              }
            ],
            "url": "{{base_url}}/auth/device-link/{{device_link_id}}/status?code_verifier={{code_verifier}}",
            "description": "Poll until approved; captures am_session cookie on success."
          },
          "response": []
        },
        {
          "name": "Device Link Preview",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/device-link/{{device_link_id}}/preview",
            "description": "Mobile scanner preview (Bearer required)."
          },
          "response": []
        },
        {
          "name": "Device Link Approve",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmation_code\": \"{{confirmation_code}}\",\n  \"machine_label\": \"Postman Test Laptop\",\n  \"device_name\": \"Chrome on Windows\"\n}"
            },
            "url": "{{base_url}}/auth/device-link/{{device_link_id}}/approve",
            "description": "Mobile approves QR login."
          },
          "response": []
        },
        {
          "name": "Device Link Deny",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Not me\"\n}"
            },
            "url": "{{base_url}}/auth/device-link/{{device_link_id}}/deny"
          },
          "response": []
        },
        {
          "name": "Device Link Cancel",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/device-link/{{device_link_id}}/cancel"
          },
          "response": []
        }
      ]
    },
    {
      "name": "06b QR Login Flow (Runner Order)",
      "description": "Run in order: Login → Start → Approve → Poll → BFF Me",
      "item": [
        {
          "name": "1 Login (for Approve Bearer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"platform\": \"android\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "response": []
        },
        {
          "name": "2 Device Link Start",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const verifier = pm.variables.replaceIn('{{$guid}}') + pm.variables.replaceIn('{{$guid}}');",
                  "const hash = CryptoJS.SHA256(verifier).toString(CryptoJS.enc.Base64)",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "pm.environment.set('code_verifier', verifier);",
                  "pm.collectionVariables.set('code_verifier', verifier);",
